{
    "name": "browser3",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "serve": "rsbuild dev",
        "build": "tsc -b && rsbuild build",
        "format": "biome format --write .",
        "lint": "biome lint .",
        "check": "biome check .",
        "generate-types": "openapi-typescript ../openapi/components.yaml -o src/types.ts --root-types --root-types-no-schema-prefix",
        "generate-schemas": "node ../openapi/extract-schemas.js",
        "cypress": "npx cypress open",
        "test": "vitest",
        "test-once": "vitest run",
        "bench": "vitest bench",
        "storybook": "storybook dev -p 6006 --no-open"
    },
    "dependencies": {
        "@fortawesome/free-solid-svg-icons": "^7.0.1",
        "@mantine/hooks": "^9.6",
        "@rjsf/core": "^6.10.1",
        "@rjsf/utils": "^6.4.1",
        "@rjsf/validator-ajv8": "^6.10.1",
        "@shish2k/react-faicon": "^0.1",
        "@shish2k/react-mqtt": "^0.1",
        "@shish2k/react-use-servertime": "^0.1",
        "@ungap/global-this": "^0.4.4",
        "abortcontroller-polyfill": "^1.7.8",
        "core-js": "^3.50.0",
        "qrcode.react": "^4.2.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-router-dom": "^7.18.4",
        "react-to-print": "^3.1.1",
        "usehooks-ts": "^3.1.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.14",
        "@rsbuild/core": "^2.2.10",
        "@rsbuild/plugin-react": "^2.0.0",
        "@rsbuild/plugin-sass": "^2.0.1",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^26.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "cypress": "^15.21.1",
        "js-yaml": "^5.4.2",
        "jsdom": "^30.1.1",
        "openapi-typescript": "git+https://github.com/shish/openapi-typescript.git?subdirectory=packages/openapi-typescript#ts7",
        "storybook": "^10.6.0",
        "storybook-react-rsbuild": "^3.6.0",
        "typescript": "^7.0",
        "vitest": "^4.1.11"
    }
}
